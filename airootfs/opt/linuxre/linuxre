#!/bin/bash

while true; do


    echo "╔══════════════════════════════════════════╗"
    echo "║               LinuxRE v0.4               ║"
    echo "║        Linux Recovery Environment        ║"
    echo "╚══════════════════════════════════════════╝"
    echo
    echo "  1) Disk Tools"
    echo "  2) Recovery"
    echo "  3) Installation"
    echo "  4) Network"
    echo "  5) System Diagnostics"
    echo "  6) Terminal"
    echo "  7) Update the Environment"
    echo
    echo "  0) Power Off"
    echo

    read -rp "Select an option: " c

    case "$c" in
        1)
            clear

            # Arch Chroot
            # shellcheck disable=SC1091
            source /opt/linuxre/lib/common.sh
            # shellcheck disable=SC1091
            source /opt/linuxre/lib/target.sh
            # shellcheck disable=SC1091
            source /opt/linuxre/lib/chroot.sh

            if ! sudo -v; then
                read -rp "Press Enter to continue..." _
                continue
            fi

            if ! sudo bash -c '
                source /opt/linuxre/lib/common.sh
                source /opt/linuxre/lib/target.sh
                source /opt/linuxre/lib/chroot.sh

                require_root || exit 1

                if ! detect_root_filesystems; then
                    warn "No supported Linux root filesystems were found."
                    exit 1
                fi

                echo
                echo "Detected root filesystems:"
                echo

                for i in "${!ROOTS[@]}"; do
                    dev="${ROOTS[$i]}"

                    echo "[$((i + 1))] $dev"

                    lsblk -no SIZE,FSTYPE,LABEL,PARTLABEL,MOUNTPOINTS "$dev" |
                        sed "s/^/    /"

                    echo
                done

                while true; do
                    read -rp "Select Arch Linux root filesystem [1-${#ROOTS[@]}]: " choice

                    if [[ "$choice" =~ ^[0-9]+$ ]] &&
                       (( choice >= 1 && choice <= ${#ROOTS[@]} )); then
                        break
                    fi

                    echo "Invalid selection."
                done

                ROOT_DEV="${ROOTS[$((choice - 1))]}"

                set_root "$ROOT_DEV" || exit 1

                if [[ "$ROOT_FSTYPE" == "btrfs" ]]; then
                    detect_btrfs_subvolume || exit 1
                fi

                prepare_target || exit 1

                if ! enter_chroot; then
                    warn "Failed to enter Arch Linux chroot."
                    exit 1
                fi
            '; then
                read -rp "Press Enter to continue..." _
                continue
            fi

            read -rp "Press Enter to continue..." _
            ;;

        2) bash /opt/linuxre/tools/recovery.sh ;;
        3) bash /opt/linuxre/tools/install.sh ;;
        4) bash /opt/linuxre/tools/network.sh ;;
        5) bash /opt/linuxre/tools/system.sh ;;
        6) clear; bash ;;
        7) bash /opt/linuxre/tools/update.sh ;;
        0) clear; sudo shutdown now ;;
        *) echo "Invalid option."; sleep 1 ;;
    esac
done
